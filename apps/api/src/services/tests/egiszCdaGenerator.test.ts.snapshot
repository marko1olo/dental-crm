exports[`egiszCdaGenerator > generateDentalCdaXml with full parameter set 1`] = `
"<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n\\n\\n\\n<ClinicalDocument xmlns=\\"urn:hl7-org:v3\\" xmlns:xsi=\\"http://www.w3.org/2001/XMLSchema-instance\\">\\n\\t<!-- DEFECT #76: realmCode required by HL7 CDA R2 / EGISZ SEMD header profile (RU) -->\\n\\t<realmCode code=\\"RU\\"/>\\n\\t<typeId root=\\"2.16.840.1.113883.1.3\\" extension=\\"POCD_HD000040\\"/>\\n\\t<templateId root=\\"1.2.643.5.1.13.13.11.1527\\"/>\\n\\t<id root=\\"1.2.643.5.1.13.13.12.2.888\\" extension=\\"doc-001\\"/>\\n\\t<code code=\\"74208-1\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Протокол стоматологического осмотра\\"/>\\n\\t<title>Протокол стоматологического осмотра</title>\\n\\t<effectiveTime value=\\"20240515160000\\"/>\\n\\t<confidentialityCode code=\\"N\\" codeSystem=\\"2.16.840.1.113883.5.25\\"/>\\n\\t<languageCode code=\\"ru-RU\\"/>\\n\\t<!-- DEFECT #88: setId = document SET (stable); id above = this version -->\\n\\t<setId root=\\"1.2.643.5.1.13.13.12.2.888\\" extension=\\"doc-001\\"/>\\n\\n\\t<versionNumber value=\\"1\\"/>\\n\\t\\n\\t<recordTarget>\\n\\n\\t\\t<patientRole>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2.888\\" extension=\\"pat-123\\"/>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"123-456-789 00\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #98: patientRole addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal patient contact is wired from the chart (patients.phone/email +\\n\\t\\t\\t\\tadministrativeProfile residential/registration address). We emit the\\n\\t\\t\\t\\treal <addr>/<telecom> when present and nullFlavor=\\"NI\\" only when the\\n\\t\\t\\t\\tchart has no contact data (we never invent an address/phone).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<patient>\\n\\n\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Иванов</family>\\n\\t\\t\\t\\t\\t<given>Иван</given>\\n\\t\\t\\t\\t\\t<given>Иванович</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t<administrativeGenderCode code=\\"1\\" codeSystem=\\"1.2.643.5.1.13.13.11.1040\\"/>\\n\\n\\t\\t\\t\\t<birthTime value=\\"19800101\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #97: patient/languageCommunication (preferred language).\\n\\t\\t\\t\\t\\tБЫЛО: patient had name + gender + birthTime only. HL7 CDA R2\\n\\t\\t\\t\\t\\tand EGISZ SEMD expect languageCommunication so the record\\n\\t\\t\\t\\t\\tdeclares the language of care/communication (ru-RU for RF\\n\\t\\t\\t\\t\\tambulatory dentistry). Without it validators flag incomplete\\n\\t\\t\\t\\t\\tpatient demographics and REMD cannot route interpreter needs.\\n\\t\\t\\t\\t\\tСТАЛО: languageCode ru-RU + preferenceInd true (primary).\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<languageCommunication>\\n\\t\\t\\t\\t\\t<languageCode code=\\"ru-RU\\"/>\\n\\t\\t\\t\\t\\t<preferenceInd value=\\"true\\"/>\\n\\t\\t\\t\\t</languageCommunication>\\n\\n\\t\\t\\t</patient>\\n\\n\\n\\t\\t</patientRole>\\n\\t</recordTarget>\\n\\t<author>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<assignedAuthor>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"987-654-321 00\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\" displayName=\\"Врач-стоматолог\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #99: assignedAuthor addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal doctor/clinic contact is wired (users.phone/email for the\\n\\t\\t\\t\\tphysician, clinics.address/phone + organizations.legalAddress/email\\n\\t\\t\\t\\tfor the MO). We emit the real <addr>/<telecom> when present and\\n\\t\\t\\t\\tnullFlavor=\\"NI\\" only when the DB has no data (no invented values).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Петров</family>\\n\\t\\t\\t\\t\\t<given>Петр</given>\\n\\t\\t\\t\\t\\t<given>Петрович</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedAuthor>\\n\\t</author>\\n\\n\\n\\t<custodian>\\n\\t\\t<assignedCustodian>\\n\\t\\t\\t<representedCustodianOrganization>\\n\\t\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"1.2.643.5.1.13.13.12.2.888\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #102: custodian representedCustodianOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired (clinics.address/phone +\\n\\t\\t\\t\\t\\torganizations.legalAddress/email); nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t</representedCustodianOrganization>\\n\\n\\t\\t</assignedCustodian>\\n\\t</custodian>\\n\\t<!--\\n\\t\\tDEFECT #96: informationRecipient (intended receiver of the SEMD).\\n\\t\\tБЫЛО: CDA had author + custodian + legalAuthenticator + authenticator\\n\\t\\tbut no informationRecipient. HL7 CDA R2 and EGISZ REMD expect the\\n\\t\\tintended recipient organization (clinic MO / REMD registry) so the\\n\\t\\tdocument is addressed for registration, not an orphan payload.\\n\\t\\tСТАЛО: informationRecipient/intendedRecipient/receivedOrganization\\n\\t\\twith clinicOid (or default MO root) + clinicName — same identity\\n\\t\\tscheme as custodian representedCustodianOrganization.\\n\\t-->\\n\\t<informationRecipient>\\n\\t\\t<intendedRecipient>\\n\\t\\t\\t<receivedOrganization>\\n\\t\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"1.2.643.5.1.13.13.12.2.888\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #103: informationRecipient receivedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t</receivedOrganization>\\n\\t\\t</intendedRecipient>\\n\\t</informationRecipient>\\n\\n\\n\\t<!--\\n\\t\\tDEFECT #75: legalAuthenticator (who signed / locks Form 043/у).\\n\\n\\t\\tБЫЛО: CDA had author + custodian only — no legalAuthenticator.\\n\\t\\tEGISZ REMD / SEMD validators require the signing physician block;\\n\\t\\twithout it the document has no legal signature party distinct from\\n\\t\\tauthor time. СТАЛО: legalAuthenticator mirrors doctorName (+ optional\\n\\t\\tSNILS/position) with time = documentClock (lockedAt when provided).\\n\\t-->\\n\\t<legalAuthenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"987-654-321 00\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\" displayName=\\"Врач-стоматолог\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #100: legalAuthenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired (users.phone/email); clinic addr\\n\\t\\t\\t\\tis used as the physician's work address. nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Петров</family>\\n\\t\\t\\t\\t\\t<given>Петр</given>\\n\\t\\t\\t\\t\\t<given>Петрович</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #107: legalAuthenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</legalAuthenticator>\\n\\t<!--\\n\\t\\tDEFECT #95: authenticator (who attested the clinical content).\\n\\t\\tБЫЛО: legalAuthenticator (#75) only — HL7 CDA R2 also allows/expects\\n\\t\\tauthenticator for the clinician who authenticates the document content\\n\\t\\t(distinct role from legal signature party). EGISZ SEMD validators that\\n\\t\\tcheck both blocks reject documents with legalAuthenticator alone when\\n\\t\\tthe authoring physician is the same person who attests the SOAP text.\\n\\t\\tСТАЛО: authenticator mirrors doctor identity + signatureCode S and\\n\\t\\ttime = documentClock (lockedAt), same scheme as legalAuthenticator.\\n\\t-->\\n\\t<authenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"987-654-321 00\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\" displayName=\\"Врач-стоматолог\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #101: authenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Петров</family>\\n\\t\\t\\t\\t\\t<given>Петр</given>\\n\\t\\t\\t\\t\\t<given>Петрович</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #108: authenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</authenticator>\\n\\t<!-- DEFECT #55/#65: encounter datetime (params.visitDate / appointment.startsAt) -->\\n\\n\\t<!--\\n\\t\\tDEFECT #93: documentationOf/serviceEvent/performer (treating physician).\\n\\t\\tБЫЛО: serviceEvent carried only effectiveTime — no performer. HL7 CDA R2\\n\\t\\tand EGISZ SEMD expect the clinician who performed the care event under\\n\\t\\tdocumentationOf (distinct from author/legalAuthenticator document roles\\n\\t\\tand from encompassingEncounter/responsibleParty). Without performer,\\n\\t\\tvalidators treat the care event as unattributed.\\n\\t\\tСТАЛО: performer typeCode=\\"PRF\\" with assignedEntity (doctor SNILS/name\\n\\t\\t+ clinic), same identity scheme as assignedAuthor / responsibleParty.\\n\\t-->\\n\\t<documentationOf>\\n\\t\\t<serviceEvent classCode=\\"PCPR\\">\\n\\t\\t\\t<effectiveTime value=\\"20240515140000\\"/>\\n\\t\\t\\t<performer typeCode=\\"PRF\\">\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"987-654-321 00\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\" displayName=\\"Врач-стоматолог\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\tDEFECT #104: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\tassignedEntity addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\tБЫЛО: performer assignedEntity had id/code/person/org\\n\\t\\t\\t\\t\\t\\tonly — no addr/telecom. SEMD validators expect contact\\n\\t\\t\\t\\t\\t\\tunder the care-event performer (mirror of\\n\\t\\t\\t\\t\\t\\tlegalAuthenticator #100 / authenticator #101 /\\n\\t\\t\\t\\t\\t\\tassignedAuthor #99). We do not invent doctor/clinic\\n\\t\\t\\t\\t\\t\\tstreet or phone.\\n\\t\\t\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t\\t\\t<family>Петров</family>\\n\\t\\t\\t\\t\\t\\t\\t<given>Петр</given>\\n\\t\\t\\t\\t\\t\\t\\t<given>Петрович</given>\\n\\t\\t\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\t\\tDEFECT #109: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\t\\trepresentedOrganization addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\t\\tБЫЛО: representedOrganization had only name child — no\\n\\t\\t\\t\\t\\t\\t\\taddr/telecom. SEMD validators expect MO contact under\\n\\t\\t\\t\\t\\t\\t\\tperformer org (mirror of authenticator org #108).\\n\\t\\t\\t\\t\\t\\t\\tWe do not invent clinic street or phone.\\n\\t\\t\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</performer>\\n\\t\\t</serviceEvent>\\n\\t</documentationOf>\\n\\t<componentOf>\\n\\t\\t<encompassingEncounter>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2.888\\" extension=\\"doc-001\\"/>\\n\\t\\t\\t<code code=\\"AMB\\" codeSystem=\\"1.2.643.5.1.13.13.11.1461\\" codeSystemName=\\"Виды медицинской помощи\\" displayName=\\"Амбулаторная помощь\\"/>\\n\\t\\t\\t<effectiveTime value=\\"20240515140000\\"/>\\n\\t\\t\\t<responsibleParty>\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"987-654-321 00\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\" displayName=\\"Врач-стоматолог\\"/>\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Петров</family>\\n\\t\\t\\t\\t\\t<given>Петр</given>\\n\\t\\t\\t\\t\\t<given>Петрович</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</responsibleParty>\\n\\t\\t\\t<location>\\n\\t\\t\\t\\t<healthCareFacility>\\n\\t\\t\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2.888\\" extension=\\"1.2.643.5.1.13.13.12.2.888\\"/>\\n\\t\\t\\t\\t\\t<location>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t\\t\\t</location>\\n\\t\\t\\t\\t\\t<serviceProviderOrganization>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>ООО Стоматология</name>\\n\\t\\t\\t\\t\\t</serviceProviderOrganization>\\n\\t\\t\\t\\t</healthCareFacility>\\n\\t\\t\\t</location>\\n\\t\\t</encompassingEncounter>\\n\\t</componentOf>\\n\\t<component>\\n\\t\\t<structuredBody>\\n\\t\\t\\t\\n\\t\\t\\t<!-- Диагноз -->\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"29548-5\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Диагнозы\\"/>\\n\\t\\t\\t\\t\\t<title>Диагноз</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Кариес дентина (МКБ-10: K02.1)</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t\\t<entry>\\n\\t\\t\\t\\t\\t\\t<observation classCode=\\"OBS\\" moodCode=\\"EVN\\">\\n\\t\\t\\t\\t\\t\\t\\t<code code=\\"29308-4\\" codeSystem=\\"2.16.840.1.113883.6.1\\" displayName=\\"Диагноз\\"/>\\n\\t\\t\\t\\t\\t\\t\\t<value xsi:type=\\"CD\\" code=\\"K02.1\\" codeSystem=\\"1.2.643.5.1.13.13.11.1005\\" displayName=\\"Кариес дентина\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t</observation>\\n\\t\\t\\t\\t\\t</entry>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t\\t\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"10164-2\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Анамнез\\"/>\\n\\t\\t\\t\\t\\t<title>Анамнез</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Жалобы на боли от сладкого</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"47519-4\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Медицинские услуги\\"/>\\n\\t\\t\\t\\t\\t<title>Проведенное лечение</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Препарирование, пломба</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"46264-8\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Medical device identifier\\"/>\\n\\t\\t\\t\\t\\t<title>Инструментальный лоток</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Штрихкод: TRAY-043-001</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t</structuredBody>\\n\\t</component>\\n</ClinicalDocument>"
`;

exports[`egiszCdaGenerator > generateDentalCdaXml with missing optional parameters 1`] = `
"<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n\\n\\n\\n<ClinicalDocument xmlns=\\"urn:hl7-org:v3\\" xmlns:xsi=\\"http://www.w3.org/2001/XMLSchema-instance\\">\\n\\t<!-- DEFECT #76: realmCode required by HL7 CDA R2 / EGISZ SEMD header profile (RU) -->\\n\\t<realmCode code=\\"RU\\"/>\\n\\t<typeId root=\\"2.16.840.1.113883.1.3\\" extension=\\"POCD_HD000040\\"/>\\n\\t<templateId root=\\"1.2.643.5.1.13.13.11.1527\\"/>\\n\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-002\\"/>\\n\\t<code code=\\"74208-1\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Протокол стоматологического осмотра\\"/>\\n\\t<title>Протокол стоматологического осмотра</title>\\n\\t<effectiveTime value=\\"20240515160000\\"/>\\n\\t<confidentialityCode code=\\"N\\" codeSystem=\\"2.16.840.1.113883.5.25\\"/>\\n\\t<languageCode code=\\"ru-RU\\"/>\\n\\t<!-- DEFECT #88: setId = document SET (stable); id above = this version -->\\n\\t<setId root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-002\\"/>\\n\\n\\t<versionNumber value=\\"1\\"/>\\n\\t\\n\\t<recordTarget>\\n\\n\\t\\t<patientRole>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"pat-456\\"/>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"111-222-333 44\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #98: patientRole addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal patient contact is wired from the chart (patients.phone/email +\\n\\t\\t\\t\\tadministrativeProfile residential/registration address). We emit the\\n\\t\\t\\t\\treal <addr>/<telecom> when present and nullFlavor=\\"NI\\" only when the\\n\\t\\t\\t\\tchart has no contact data (we never invent an address/phone).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<patient>\\n\\n\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Смирнова</family>\\n\\t\\t\\t\\t\\t<given>Анна</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t<administrativeGenderCode code=\\"2\\" codeSystem=\\"1.2.643.5.1.13.13.11.1040\\"/>\\n\\n\\t\\t\\t\\t<birthTime nullFlavor=\\"UNK\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #97: patient/languageCommunication (preferred language).\\n\\t\\t\\t\\t\\tБЫЛО: patient had name + gender + birthTime only. HL7 CDA R2\\n\\t\\t\\t\\t\\tand EGISZ SEMD expect languageCommunication so the record\\n\\t\\t\\t\\t\\tdeclares the language of care/communication (ru-RU for RF\\n\\t\\t\\t\\t\\tambulatory dentistry). Without it validators flag incomplete\\n\\t\\t\\t\\t\\tpatient demographics and REMD cannot route interpreter needs.\\n\\t\\t\\t\\t\\tСТАЛО: languageCode ru-RU + preferenceInd true (primary).\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<languageCommunication>\\n\\t\\t\\t\\t\\t<languageCode code=\\"ru-RU\\"/>\\n\\t\\t\\t\\t\\t<preferenceInd value=\\"true\\"/>\\n\\t\\t\\t\\t</languageCommunication>\\n\\n\\t\\t\\t</patient>\\n\\n\\n\\t\\t</patientRole>\\n\\t</recordTarget>\\n\\t<author>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<assignedAuthor>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #99: assignedAuthor addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal doctor/clinic contact is wired (users.phone/email for the\\n\\t\\t\\t\\tphysician, clinics.address/phone + organizations.legalAddress/email\\n\\t\\t\\t\\tfor the MO). We emit the real <addr>/<telecom> when present and\\n\\t\\t\\t\\tnullFlavor=\\"NI\\" only when the DB has no data (no invented values).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Сидорова</family>\\n\\t\\t\\t\\t\\t<given>Елена</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedAuthor>\\n\\t</author>\\n\\n\\n\\t<custodian>\\n\\t\\t<assignedCustodian>\\n\\t\\t\\t<representedCustodianOrganization>\\n\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #102: custodian representedCustodianOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired (clinics.address/phone +\\n\\t\\t\\t\\t\\torganizations.legalAddress/email); nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t</representedCustodianOrganization>\\n\\n\\t\\t</assignedCustodian>\\n\\t</custodian>\\n\\t<!--\\n\\t\\tDEFECT #96: informationRecipient (intended receiver of the SEMD).\\n\\t\\tБЫЛО: CDA had author + custodian + legalAuthenticator + authenticator\\n\\t\\tbut no informationRecipient. HL7 CDA R2 and EGISZ REMD expect the\\n\\t\\tintended recipient organization (clinic MO / REMD registry) so the\\n\\t\\tdocument is addressed for registration, not an orphan payload.\\n\\t\\tСТАЛО: informationRecipient/intendedRecipient/receivedOrganization\\n\\t\\twith clinicOid (or default MO root) + clinicName — same identity\\n\\t\\tscheme as custodian representedCustodianOrganization.\\n\\t-->\\n\\t<informationRecipient>\\n\\t\\t<intendedRecipient>\\n\\t\\t\\t<receivedOrganization>\\n\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #103: informationRecipient receivedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t</receivedOrganization>\\n\\t\\t</intendedRecipient>\\n\\t</informationRecipient>\\n\\n\\n\\t<!--\\n\\t\\tDEFECT #75: legalAuthenticator (who signed / locks Form 043/у).\\n\\n\\t\\tБЫЛО: CDA had author + custodian only — no legalAuthenticator.\\n\\t\\tEGISZ REMD / SEMD validators require the signing physician block;\\n\\t\\twithout it the document has no legal signature party distinct from\\n\\t\\tauthor time. СТАЛО: legalAuthenticator mirrors doctorName (+ optional\\n\\t\\tSNILS/position) with time = documentClock (lockedAt when provided).\\n\\t-->\\n\\t<legalAuthenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #100: legalAuthenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired (users.phone/email); clinic addr\\n\\t\\t\\t\\tis used as the physician's work address. nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Сидорова</family>\\n\\t\\t\\t\\t\\t<given>Елена</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #107: legalAuthenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</legalAuthenticator>\\n\\t<!--\\n\\t\\tDEFECT #95: authenticator (who attested the clinical content).\\n\\t\\tБЫЛО: legalAuthenticator (#75) only — HL7 CDA R2 also allows/expects\\n\\t\\tauthenticator for the clinician who authenticates the document content\\n\\t\\t(distinct role from legal signature party). EGISZ SEMD validators that\\n\\t\\tcheck both blocks reject documents with legalAuthenticator alone when\\n\\t\\tthe authoring physician is the same person who attests the SOAP text.\\n\\t\\tСТАЛО: authenticator mirrors doctor identity + signatureCode S and\\n\\t\\ttime = documentClock (lockedAt), same scheme as legalAuthenticator.\\n\\t-->\\n\\t<authenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #101: authenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Сидорова</family>\\n\\t\\t\\t\\t\\t<given>Елена</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #108: authenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</authenticator>\\n\\t<!-- DEFECT #55/#65: encounter datetime (params.visitDate / appointment.startsAt) -->\\n\\n\\t<!--\\n\\t\\tDEFECT #93: documentationOf/serviceEvent/performer (treating physician).\\n\\t\\tБЫЛО: serviceEvent carried only effectiveTime — no performer. HL7 CDA R2\\n\\t\\tand EGISZ SEMD expect the clinician who performed the care event under\\n\\t\\tdocumentationOf (distinct from author/legalAuthenticator document roles\\n\\t\\tand from encompassingEncounter/responsibleParty). Without performer,\\n\\t\\tvalidators treat the care event as unattributed.\\n\\t\\tСТАЛО: performer typeCode=\\"PRF\\" with assignedEntity (doctor SNILS/name\\n\\t\\t+ clinic), same identity scheme as assignedAuthor / responsibleParty.\\n\\t-->\\n\\t<documentationOf>\\n\\t\\t<serviceEvent classCode=\\"PCPR\\">\\n\\t\\t\\t<effectiveTime value=\\"20240516150000\\"/>\\n\\t\\t\\t<performer typeCode=\\"PRF\\">\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\tDEFECT #104: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\tassignedEntity addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\tБЫЛО: performer assignedEntity had id/code/person/org\\n\\t\\t\\t\\t\\t\\tonly — no addr/telecom. SEMD validators expect contact\\n\\t\\t\\t\\t\\t\\tunder the care-event performer (mirror of\\n\\t\\t\\t\\t\\t\\tlegalAuthenticator #100 / authenticator #101 /\\n\\t\\t\\t\\t\\t\\tassignedAuthor #99). We do not invent doctor/clinic\\n\\t\\t\\t\\t\\t\\tstreet or phone.\\n\\t\\t\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t\\t\\t<family>Сидорова</family>\\n\\t\\t\\t\\t\\t\\t\\t<given>Елена</given>\\n\\t\\t\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\t\\tDEFECT #109: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\t\\trepresentedOrganization addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\t\\tБЫЛО: representedOrganization had only name child — no\\n\\t\\t\\t\\t\\t\\t\\taddr/telecom. SEMD validators expect MO contact under\\n\\t\\t\\t\\t\\t\\t\\tperformer org (mirror of authenticator org #108).\\n\\t\\t\\t\\t\\t\\t\\tWe do not invent clinic street or phone.\\n\\t\\t\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</performer>\\n\\t\\t</serviceEvent>\\n\\t</documentationOf>\\n\\t<componentOf>\\n\\t\\t<encompassingEncounter>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-002\\"/>\\n\\t\\t\\t<code code=\\"AMB\\" codeSystem=\\"1.2.643.5.1.13.13.11.1461\\" codeSystemName=\\"Виды медицинской помощи\\" displayName=\\"Амбулаторная помощь\\"/>\\n\\t\\t\\t<effectiveTime value=\\"20240516150000\\"/>\\n\\t\\t\\t<responsibleParty>\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Сидорова</family>\\n\\t\\t\\t\\t\\t<given>Елена</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</responsibleParty>\\n\\t\\t\\t<location>\\n\\t\\t\\t\\t<healthCareFacility>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<location>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t\\t\\t</location>\\n\\t\\t\\t\\t\\t<serviceProviderOrganization>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Городская Поликлиника</name>\\n\\t\\t\\t\\t\\t</serviceProviderOrganization>\\n\\t\\t\\t\\t</healthCareFacility>\\n\\t\\t\\t</location>\\n\\t\\t</encompassingEncounter>\\n\\t</componentOf>\\n\\t<component>\\n\\t\\t<structuredBody>\\n\\t\\t\\t\\n\\t\\t\\t<!-- Диагноз -->\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"29548-5\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Диагнозы\\"/>\\n\\t\\t\\t\\t\\t<title>Диагноз</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Пульпит (МКБ-10: K04.0)</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t\\t<entry>\\n\\t\\t\\t\\t\\t\\t<observation classCode=\\"OBS\\" moodCode=\\"EVN\\">\\n\\t\\t\\t\\t\\t\\t\\t<code code=\\"29308-4\\" codeSystem=\\"2.16.840.1.113883.6.1\\" displayName=\\"Диагноз\\"/>\\n\\t\\t\\t\\t\\t\\t\\t<value xsi:type=\\"CD\\" code=\\"K04.0\\" codeSystem=\\"1.2.643.5.1.13.13.11.1005\\" displayName=\\"Пульпит\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t</observation>\\n\\t\\t\\t\\t\\t</entry>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t</structuredBody>\\n\\t</component>\\n</ClinicalDocument>"
`;

exports[`egiszCdaGenerator > generateDentalCdaXml with other/null gender 1`] = `
"<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n\\n\\n\\n<ClinicalDocument xmlns=\\"urn:hl7-org:v3\\" xmlns:xsi=\\"http://www.w3.org/2001/XMLSchema-instance\\">\\n\\t<!-- DEFECT #76: realmCode required by HL7 CDA R2 / EGISZ SEMD header profile (RU) -->\\n\\t<realmCode code=\\"RU\\"/>\\n\\t<typeId root=\\"2.16.840.1.113883.1.3\\" extension=\\"POCD_HD000040\\"/>\\n\\t<templateId root=\\"1.2.643.5.1.13.13.11.1527\\"/>\\n\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-003\\"/>\\n\\t<code code=\\"74208-1\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Протокол стоматологического осмотра\\"/>\\n\\t<title>Протокол стоматологического осмотра</title>\\n\\t<effectiveTime value=\\"20240515160000\\"/>\\n\\t<confidentialityCode code=\\"N\\" codeSystem=\\"2.16.840.1.113883.5.25\\"/>\\n\\t<languageCode code=\\"ru-RU\\"/>\\n\\t<!-- DEFECT #88: setId = document SET (stable); id above = this version -->\\n\\t<setId root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-003\\"/>\\n\\n\\t<versionNumber value=\\"1\\"/>\\n\\t\\n\\t<recordTarget>\\n\\n\\t\\t<patientRole>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"pat-789\\"/>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"000-000-000 00\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #98: patientRole addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal patient contact is wired from the chart (patients.phone/email +\\n\\t\\t\\t\\tadministrativeProfile residential/registration address). We emit the\\n\\t\\t\\t\\treal <addr>/<telecom> when present and nullFlavor=\\"NI\\" only when the\\n\\t\\t\\t\\tchart has no contact data (we never invent an address/phone).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<patient>\\n\\n\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Джонс</family>\\n\\t\\t\\t\\t\\t<given>Алекс</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t<administrativeGenderCode nullFlavor=\\"UNK\\"/>\\n\\n\\t\\t\\t\\t<birthTime value=\\"19900505\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #97: patient/languageCommunication (preferred language).\\n\\t\\t\\t\\t\\tБЫЛО: patient had name + gender + birthTime only. HL7 CDA R2\\n\\t\\t\\t\\t\\tand EGISZ SEMD expect languageCommunication so the record\\n\\t\\t\\t\\t\\tdeclares the language of care/communication (ru-RU for RF\\n\\t\\t\\t\\t\\tambulatory dentistry). Without it validators flag incomplete\\n\\t\\t\\t\\t\\tpatient demographics and REMD cannot route interpreter needs.\\n\\t\\t\\t\\t\\tСТАЛО: languageCode ru-RU + preferenceInd true (primary).\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<languageCommunication>\\n\\t\\t\\t\\t\\t<languageCode code=\\"ru-RU\\"/>\\n\\t\\t\\t\\t\\t<preferenceInd value=\\"true\\"/>\\n\\t\\t\\t\\t</languageCommunication>\\n\\n\\t\\t\\t</patient>\\n\\n\\n\\t\\t</patientRole>\\n\\t</recordTarget>\\n\\t<author>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<assignedAuthor>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #99: assignedAuthor addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal doctor/clinic contact is wired (users.phone/email for the\\n\\t\\t\\t\\tphysician, clinics.address/phone + organizations.legalAddress/email\\n\\t\\t\\t\\tfor the MO). We emit the real <addr>/<telecom> when present and\\n\\t\\t\\t\\tnullFlavor=\\"NI\\" only when the DB has no data (no invented values).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedAuthor>\\n\\t</author>\\n\\n\\n\\t<custodian>\\n\\t\\t<assignedCustodian>\\n\\t\\t\\t<representedCustodianOrganization>\\n\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #102: custodian representedCustodianOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired (clinics.address/phone +\\n\\t\\t\\t\\t\\torganizations.legalAddress/email); nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedCustodianOrganization>\\n\\n\\t\\t</assignedCustodian>\\n\\t</custodian>\\n\\t<!--\\n\\t\\tDEFECT #96: informationRecipient (intended receiver of the SEMD).\\n\\t\\tБЫЛО: CDA had author + custodian + legalAuthenticator + authenticator\\n\\t\\tbut no informationRecipient. HL7 CDA R2 and EGISZ REMD expect the\\n\\t\\tintended recipient organization (clinic MO / REMD registry) so the\\n\\t\\tdocument is addressed for registration, not an orphan payload.\\n\\t\\tСТАЛО: informationRecipient/intendedRecipient/receivedOrganization\\n\\t\\twith clinicOid (or default MO root) + clinicName — same identity\\n\\t\\tscheme as custodian representedCustodianOrganization.\\n\\t-->\\n\\t<informationRecipient>\\n\\t\\t<intendedRecipient>\\n\\t\\t\\t<receivedOrganization>\\n\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #103: informationRecipient receivedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</receivedOrganization>\\n\\t\\t</intendedRecipient>\\n\\t</informationRecipient>\\n\\n\\n\\t<!--\\n\\t\\tDEFECT #75: legalAuthenticator (who signed / locks Form 043/у).\\n\\n\\t\\tБЫЛО: CDA had author + custodian only — no legalAuthenticator.\\n\\t\\tEGISZ REMD / SEMD validators require the signing physician block;\\n\\t\\twithout it the document has no legal signature party distinct from\\n\\t\\tauthor time. СТАЛО: legalAuthenticator mirrors doctorName (+ optional\\n\\t\\tSNILS/position) with time = documentClock (lockedAt when provided).\\n\\t-->\\n\\t<legalAuthenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #100: legalAuthenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired (users.phone/email); clinic addr\\n\\t\\t\\t\\tis used as the physician's work address. nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #107: legalAuthenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</legalAuthenticator>\\n\\t<!--\\n\\t\\tDEFECT #95: authenticator (who attested the clinical content).\\n\\t\\tБЫЛО: legalAuthenticator (#75) only — HL7 CDA R2 also allows/expects\\n\\t\\tauthenticator for the clinician who authenticates the document content\\n\\t\\t(distinct role from legal signature party). EGISZ SEMD validators that\\n\\t\\tcheck both blocks reject documents with legalAuthenticator alone when\\n\\t\\tthe authoring physician is the same person who attests the SOAP text.\\n\\t\\tСТАЛО: authenticator mirrors doctor identity + signatureCode S and\\n\\t\\ttime = documentClock (lockedAt), same scheme as legalAuthenticator.\\n\\t-->\\n\\t<authenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #101: authenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #108: authenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</authenticator>\\n\\t<!-- DEFECT #55/#65: encounter datetime (params.visitDate / appointment.startsAt) -->\\n\\n\\t<!--\\n\\t\\tDEFECT #93: documentationOf/serviceEvent/performer (treating physician).\\n\\t\\tБЫЛО: serviceEvent carried only effectiveTime — no performer. HL7 CDA R2\\n\\t\\tand EGISZ SEMD expect the clinician who performed the care event under\\n\\t\\tdocumentationOf (distinct from author/legalAuthenticator document roles\\n\\t\\tand from encompassingEncounter/responsibleParty). Without performer,\\n\\t\\tvalidators treat the care event as unattributed.\\n\\t\\tСТАЛО: performer typeCode=\\"PRF\\" with assignedEntity (doctor SNILS/name\\n\\t\\t+ clinic), same identity scheme as assignedAuthor / responsibleParty.\\n\\t-->\\n\\t<documentationOf>\\n\\t\\t<serviceEvent classCode=\\"PCPR\\">\\n\\t\\t\\t<effectiveTime value=\\"20240517130000\\"/>\\n\\t\\t\\t<performer typeCode=\\"PRF\\">\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\tDEFECT #104: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\tassignedEntity addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\tБЫЛО: performer assignedEntity had id/code/person/org\\n\\t\\t\\t\\t\\t\\tonly — no addr/telecom. SEMD validators expect contact\\n\\t\\t\\t\\t\\t\\tunder the care-event performer (mirror of\\n\\t\\t\\t\\t\\t\\tlegalAuthenticator #100 / authenticator #101 /\\n\\t\\t\\t\\t\\t\\tassignedAuthor #99). We do not invent doctor/clinic\\n\\t\\t\\t\\t\\t\\tstreet or phone.\\n\\t\\t\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\t\\tDEFECT #109: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\t\\trepresentedOrganization addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\t\\tБЫЛО: representedOrganization had only name child — no\\n\\t\\t\\t\\t\\t\\t\\taddr/telecom. SEMD validators expect MO contact under\\n\\t\\t\\t\\t\\t\\t\\tperformer org (mirror of authenticator org #108).\\n\\t\\t\\t\\t\\t\\t\\tWe do not invent clinic street or phone.\\n\\t\\t\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</performer>\\n\\t\\t</serviceEvent>\\n\\t</documentationOf>\\n\\t<componentOf>\\n\\t\\t<encompassingEncounter>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-003\\"/>\\n\\t\\t\\t<code code=\\"AMB\\" codeSystem=\\"1.2.643.5.1.13.13.11.1461\\" codeSystemName=\\"Виды медицинской помощи\\" displayName=\\"Амбулаторная помощь\\"/>\\n\\t\\t\\t<effectiveTime value=\\"20240517130000\\"/>\\n\\t\\t\\t<responsibleParty>\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</responsibleParty>\\n\\t\\t\\t<location>\\n\\t\\t\\t\\t<healthCareFacility>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<location>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t\\t\\t</location>\\n\\t\\t\\t\\t\\t<serviceProviderOrganization>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t\\t\\t</serviceProviderOrganization>\\n\\t\\t\\t\\t</healthCareFacility>\\n\\t\\t\\t</location>\\n\\t\\t</encompassingEncounter>\\n\\t</componentOf>\\n\\t<component>\\n\\t\\t<structuredBody>\\n\\t\\t\\t\\n\\t\\t\\t<!-- Диагноз -->\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"29548-5\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Диагнозы\\"/>\\n\\t\\t\\t\\t\\t<title>Диагноз</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Гингивит (МКБ-10: K05.0)</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t\\t<entry>\\n\\t\\t\\t\\t\\t\\t<observation classCode=\\"OBS\\" moodCode=\\"EVN\\">\\n\\t\\t\\t\\t\\t\\t\\t<code code=\\"29308-4\\" codeSystem=\\"2.16.840.1.113883.6.1\\" displayName=\\"Диагноз\\"/>\\n\\t\\t\\t\\t\\t\\t\\t<value xsi:type=\\"CD\\" code=\\"K05.0\\" codeSystem=\\"1.2.643.5.1.13.13.11.1005\\" displayName=\\"Гингивит\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t</observation>\\n\\t\\t\\t\\t\\t</entry>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t</structuredBody>\\n\\t</component>\\n</ClinicalDocument>"
`;

exports[`egiszCdaGenerator > generateDentalCdaXml with other/null gender 2`] = `
"<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\n\\n\\n\\n<ClinicalDocument xmlns=\\"urn:hl7-org:v3\\" xmlns:xsi=\\"http://www.w3.org/2001/XMLSchema-instance\\">\\n\\t<!-- DEFECT #76: realmCode required by HL7 CDA R2 / EGISZ SEMD header profile (RU) -->\\n\\t<realmCode code=\\"RU\\"/>\\n\\t<typeId root=\\"2.16.840.1.113883.1.3\\" extension=\\"POCD_HD000040\\"/>\\n\\t<templateId root=\\"1.2.643.5.1.13.13.11.1527\\"/>\\n\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-003\\"/>\\n\\t<code code=\\"74208-1\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Протокол стоматологического осмотра\\"/>\\n\\t<title>Протокол стоматологического осмотра</title>\\n\\t<effectiveTime value=\\"20240515160000\\"/>\\n\\t<confidentialityCode code=\\"N\\" codeSystem=\\"2.16.840.1.113883.5.25\\"/>\\n\\t<languageCode code=\\"ru-RU\\"/>\\n\\t<!-- DEFECT #88: setId = document SET (stable); id above = this version -->\\n\\t<setId root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-003\\"/>\\n\\n\\t<versionNumber value=\\"1\\"/>\\n\\t\\n\\t<recordTarget>\\n\\n\\t\\t<patientRole>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"pat-789\\"/>\\n\\t\\t\\t<id root=\\"1.2.643.100.3\\" extension=\\"000-000-000 00\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #98: patientRole addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal patient contact is wired from the chart (patients.phone/email +\\n\\t\\t\\t\\tadministrativeProfile residential/registration address). We emit the\\n\\t\\t\\t\\treal <addr>/<telecom> when present and nullFlavor=\\"NI\\" only when the\\n\\t\\t\\t\\tchart has no contact data (we never invent an address/phone).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<patient>\\n\\n\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Джонс</family>\\n\\t\\t\\t\\t\\t<given>Алекс</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t<administrativeGenderCode nullFlavor=\\"UNK\\"/>\\n\\n\\t\\t\\t\\t<birthTime value=\\"19900505\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #97: patient/languageCommunication (preferred language).\\n\\t\\t\\t\\t\\tБЫЛО: patient had name + gender + birthTime only. HL7 CDA R2\\n\\t\\t\\t\\t\\tand EGISZ SEMD expect languageCommunication so the record\\n\\t\\t\\t\\t\\tdeclares the language of care/communication (ru-RU for RF\\n\\t\\t\\t\\t\\tambulatory dentistry). Without it validators flag incomplete\\n\\t\\t\\t\\t\\tpatient demographics and REMD cannot route interpreter needs.\\n\\t\\t\\t\\t\\tСТАЛО: languageCode ru-RU + preferenceInd true (primary).\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<languageCommunication>\\n\\t\\t\\t\\t\\t<languageCode code=\\"ru-RU\\"/>\\n\\t\\t\\t\\t\\t<preferenceInd value=\\"true\\"/>\\n\\t\\t\\t\\t</languageCommunication>\\n\\n\\t\\t\\t</patient>\\n\\n\\n\\t\\t</patientRole>\\n\\t</recordTarget>\\n\\t<author>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<assignedAuthor>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #99: assignedAuthor addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\tReal doctor/clinic contact is wired (users.phone/email for the\\n\\t\\t\\t\\tphysician, clinics.address/phone + organizations.legalAddress/email\\n\\t\\t\\t\\tfor the MO). We emit the real <addr>/<telecom> when present and\\n\\t\\t\\t\\tnullFlavor=\\"NI\\" only when the DB has no data (no invented values).\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedAuthor>\\n\\t</author>\\n\\n\\n\\t<custodian>\\n\\t\\t<assignedCustodian>\\n\\t\\t\\t<representedCustodianOrganization>\\n\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #102: custodian representedCustodianOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired (clinics.address/phone +\\n\\t\\t\\t\\t\\torganizations.legalAddress/email); nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedCustodianOrganization>\\n\\n\\t\\t</assignedCustodian>\\n\\t</custodian>\\n\\t<!--\\n\\t\\tDEFECT #96: informationRecipient (intended receiver of the SEMD).\\n\\t\\tБЫЛО: CDA had author + custodian + legalAuthenticator + authenticator\\n\\t\\tbut no informationRecipient. HL7 CDA R2 and EGISZ REMD expect the\\n\\t\\tintended recipient organization (clinic MO / REMD registry) so the\\n\\t\\tdocument is addressed for registration, not an orphan payload.\\n\\t\\tСТАЛО: informationRecipient/intendedRecipient/receivedOrganization\\n\\t\\twith clinicOid (or default MO root) + clinicName — same identity\\n\\t\\tscheme as custodian representedCustodianOrganization.\\n\\t-->\\n\\t<informationRecipient>\\n\\t\\t<intendedRecipient>\\n\\t\\t\\t<receivedOrganization>\\n\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #103: informationRecipient receivedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</receivedOrganization>\\n\\t\\t</intendedRecipient>\\n\\t</informationRecipient>\\n\\n\\n\\t<!--\\n\\t\\tDEFECT #75: legalAuthenticator (who signed / locks Form 043/у).\\n\\n\\t\\tБЫЛО: CDA had author + custodian only — no legalAuthenticator.\\n\\t\\tEGISZ REMD / SEMD validators require the signing physician block;\\n\\t\\twithout it the document has no legal signature party distinct from\\n\\t\\tauthor time. СТАЛО: legalAuthenticator mirrors doctorName (+ optional\\n\\t\\tSNILS/position) with time = documentClock (lockedAt when provided).\\n\\t-->\\n\\t<legalAuthenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #100: legalAuthenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired (users.phone/email); clinic addr\\n\\t\\t\\t\\tis used as the physician's work address. nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #107: legalAuthenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</legalAuthenticator>\\n\\t<!--\\n\\t\\tDEFECT #95: authenticator (who attested the clinical content).\\n\\t\\tБЫЛО: legalAuthenticator (#75) only — HL7 CDA R2 also allows/expects\\n\\t\\tauthenticator for the clinician who authenticates the document content\\n\\t\\t(distinct role from legal signature party). EGISZ SEMD validators that\\n\\t\\tcheck both blocks reject documents with legalAuthenticator alone when\\n\\t\\tthe authoring physician is the same person who attests the SOAP text.\\n\\t\\tСТАЛО: authenticator mirrors doctor identity + signatureCode S and\\n\\t\\ttime = documentClock (lockedAt), same scheme as legalAuthenticator.\\n\\t-->\\n\\t<authenticator>\\n\\t\\t<time value=\\"20240515160000\\"/>\\n\\t\\t<signatureCode code=\\"S\\"/>\\n\\t\\t<assignedEntity>\\n\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<!--\\n\\t\\t\\t\\tDEFECT #101: authenticator assignedEntity addr + telecom.\\n\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t-->\\n\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t<assignedPerson>\\n\\n\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t</assignedPerson>\\n\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\tDEFECT #108: authenticator representedOrganization\\n\\t\\t\\t\\t\\taddr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t-->\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t</assignedEntity>\\n\\t</authenticator>\\n\\t<!-- DEFECT #55/#65: encounter datetime (params.visitDate / appointment.startsAt) -->\\n\\n\\t<!--\\n\\t\\tDEFECT #93: documentationOf/serviceEvent/performer (treating physician).\\n\\t\\tБЫЛО: serviceEvent carried only effectiveTime — no performer. HL7 CDA R2\\n\\t\\tand EGISZ SEMD expect the clinician who performed the care event under\\n\\t\\tdocumentationOf (distinct from author/legalAuthenticator document roles\\n\\t\\tand from encompassingEncounter/responsibleParty). Without performer,\\n\\t\\tvalidators treat the care event as unattributed.\\n\\t\\tСТАЛО: performer typeCode=\\"PRF\\" with assignedEntity (doctor SNILS/name\\n\\t\\t+ clinic), same identity scheme as assignedAuthor / responsibleParty.\\n\\t-->\\n\\t<documentationOf>\\n\\t\\t<serviceEvent classCode=\\"PCPR\\">\\n\\t\\t\\t<effectiveTime value=\\"20240517130000\\"/>\\n\\t\\t\\t<performer typeCode=\\"PRF\\">\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\tDEFECT #104: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\tassignedEntity addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\tБЫЛО: performer assignedEntity had id/code/person/org\\n\\t\\t\\t\\t\\t\\tonly — no addr/telecom. SEMD validators expect contact\\n\\t\\t\\t\\t\\t\\tunder the care-event performer (mirror of\\n\\t\\t\\t\\t\\t\\tlegalAuthenticator #100 / authenticator #101 /\\n\\t\\t\\t\\t\\t\\tassignedAuthor #99). We do not invent doctor/clinic\\n\\t\\t\\t\\t\\t\\tstreet or phone.\\n\\t\\t\\t\\t\\t\\tReal doctor contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t\\t\\t<!--\\n\\t\\t\\t\\t\\t\\t\\tDEFECT #109: documentationOf/serviceEvent/performer\\n\\t\\t\\t\\t\\t\\t\\trepresentedOrganization addr + telecom (HL7 CDA R2 / EGISZ SEMD).\\n\\t\\t\\t\\t\\t\\t\\tБЫЛО: representedOrganization had only name child — no\\n\\t\\t\\t\\t\\t\\t\\taddr/telecom. SEMD validators expect MO contact under\\n\\t\\t\\t\\t\\t\\t\\tperformer org (mirror of authenticator org #108).\\n\\t\\t\\t\\t\\t\\t\\tWe do not invent clinic street or phone.\\n\\t\\t\\t\\t\\t\\t\\tReal MO contact is wired; nullFlavor only when absent.\\n\\t\\t\\t\\t\\t\\t-->\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</performer>\\n\\t\\t</serviceEvent>\\n\\t</documentationOf>\\n\\t<componentOf>\\n\\t\\t<encompassingEncounter>\\n\\t\\t\\t<id root=\\"1.2.643.5.1.13.13.12.2\\" extension=\\"doc-003\\"/>\\n\\t\\t\\t<code code=\\"AMB\\" codeSystem=\\"1.2.643.5.1.13.13.11.1461\\" codeSystemName=\\"Виды медицинской помощи\\" displayName=\\"Амбулаторная помощь\\"/>\\n\\t\\t\\t<effectiveTime value=\\"20240517130000\\"/>\\n\\t\\t\\t<responsibleParty>\\n\\t\\t\\t\\t<assignedEntity>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<code nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<assignedPerson>\\n\\t\\t\\t\\t\\t\\t<name>\\n\\t\\t\\t\\t\\t<family>Врачев</family>\\n\\t\\t\\t\\t\\t<given>Врач</given>\\n\\t\\t\\t\\t</name>\\n\\t\\t\\t\\t\\t</assignedPerson>\\n\\t\\t\\t\\t\\t<representedOrganization>\\n\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t</representedOrganization>\\n\\t\\t\\t\\t</assignedEntity>\\n\\t\\t\\t</responsibleParty>\\n\\t\\t\\t<location>\\n\\t\\t\\t\\t<healthCareFacility>\\n\\t\\t\\t\\t\\t<id nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t<location>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t\\t\\t</location>\\n\\t\\t\\t\\t\\t<serviceProviderOrganization>\\n\\t\\t\\t\\t\\t\\t<addr nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<telecom nullFlavor=\\"NI\\"/>\\n\\t\\t\\t\\t\\t\\t<name>Клиника</name>\\n\\t\\t\\t\\t\\t</serviceProviderOrganization>\\n\\t\\t\\t\\t</healthCareFacility>\\n\\t\\t\\t</location>\\n\\t\\t</encompassingEncounter>\\n\\t</componentOf>\\n\\t<component>\\n\\t\\t<structuredBody>\\n\\t\\t\\t\\n\\t\\t\\t<!-- Диагноз -->\\n\\t\\t\\t<component>\\n\\t\\t\\t\\t<section>\\n\\t\\t\\t\\t\\t<code code=\\"29548-5\\" codeSystem=\\"2.16.840.1.113883.6.1\\" codeSystemName=\\"LOINC\\" displayName=\\"Диагнозы\\"/>\\n\\t\\t\\t\\t\\t<title>Диагноз</title>\\n\\t\\t\\t\\t\\t<text>\\n\\t\\t\\t\\t\\t\\t<paragraph>Гингивит (МКБ-10: K05.0)</paragraph>\\n\\t\\t\\t\\t\\t</text>\\n\\t\\t\\t\\t\\t<entry>\\n\\t\\t\\t\\t\\t\\t<observation classCode=\\"OBS\\" moodCode=\\"EVN\\">\\n\\t\\t\\t\\t\\t\\t\\t<code code=\\"29308-4\\" codeSystem=\\"2.16.840.1.113883.6.1\\" displayName=\\"Диагноз\\"/>\\n\\t\\t\\t\\t\\t\\t\\t<value xsi:type=\\"CD\\" code=\\"K05.0\\" codeSystem=\\"1.2.643.5.1.13.13.11.1005\\" displayName=\\"Гингивит\\"/>\\n\\t\\t\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\t</observation>\\n\\t\\t\\t\\t\\t</entry>\\n\\t\\t\\t\\t</section>\\n\\t\\t\\t</component>\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t\\t\\n\\t\\t</structuredBody>\\n\\t</component>\\n</ClinicalDocument>"
`;
