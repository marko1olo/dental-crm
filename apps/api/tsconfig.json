{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"noEmitOnError": false
	},
	"include": ["src"],
	"exclude": ["src/tests", "src/**/*.test.ts", "src/scripts", "src/services"]
}
