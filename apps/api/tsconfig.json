{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"noEmitOnError": false
	},
	"include": ["src"],
	// Список исключений был причиной того, что «компилируется» не значило
	// «работает». Раньше отсюда целиком выпадали src/services и src/scripts —
	// это боевой код, а не вспомогательный. Под прикрытием исключения там
	// накопились ошибки, ломавшие модули на старте: notificationWorker,
	// postOpCareTrigger и biAnalyticsWorker импортировали из db/schema.js
	// таблицы, которых в модели не было, и падали при загрузке с
	// «does not provide an export named». npm run typecheck при этом показывал
	// ноль ошибок.
	//
	// Четвёртый файл из того списка, src/services/syncDaemon.ts, удалён
	// 2026-07-28: он ставил медкартам isSynced: true, не отправив ни одного
	// байта — в файле не было ни одного сетевого вызова.
	//
	// Теперь исключены только тесты (у них отдельный прогон, npm test) и
	// поимённо — мёртвый код эпохи PGlite, который ничего не импортирует.
	// Добавлять сюда каталоги боевого кода нельзя.
	"exclude": [
		"src/tests",
		"src/**/*.test.ts",
		"src/**/*.bench.ts",
		// Движок PGlite из проекта удалён (db/client.ts работает через
		// node-postgres), а пакет @electric-sql/pglite не установлен. Файлы
		// оставлены как есть — на них никто не ссылается.
		"src/services/syncEngine.ts",
		"src/scripts/setup-fresh-db.ts",
		"src/scripts/patch-owner-credentials.ts",
		"src/scripts/seedPglite.ts",
		// Демо-данные и легаси-моки: не участвуют в боевых маршрутах.
		"src/sampleData_opt.ts",
		"src/telegram/legacyMocks.ts"
	]
}
