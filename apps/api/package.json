{
	"name": "@dental/api",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"check:contract-breach": "node ../../scripts/contract-breach-analysis.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
		"test": "node --import tsx --import ./src/tests/support/poolTeardown.ts --test \"src/**/*.test.ts\"",
		"test:contract": "node --import tsx --test src/tests/contract-breach-proofs.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/scripts/migrate.ts",
		"db:migrate:baseline": "tsx src/scripts/migrate.ts --baseline",
		"db:migrate:check": "tsx src/scripts/migrate.ts --dry-run",
		"db:migrate:strict": "tsx src/scripts/migrate.ts --strict",
		"verify:migration": "tsx src/scripts/verify-migration-engine.ts",
		"verify:migration:http": "tsx src/scripts/verify-migration-http.ts",
		"verify:migration:formats": "tsx src/scripts/verify-migration-formats.ts"
	},
	"dependencies": {
		"@dental/shared": "*",
		"@fastify/cors": "^10.0.1",
		"@fastify/helmet": "^13.1.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/websocket": "^11.2.0",
		"decimal.js": "^10.6.0",
		"dicom-parser": "^1.8.21",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.3.3",
		"pg": "^8.15.6",
		"sharp": "^0.35.3",
		"undici": "^8.5.0",
		"ws": "^8.21.0",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@types/node": "^22.15.18",
		"@types/pg": "^8.11.14",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	}
}
