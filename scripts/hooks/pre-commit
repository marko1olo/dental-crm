#!/bin/sh
# =============================================================================
# THE IRON GATE (pre-commit)
#
# ГДЕ ЛЕЖИТ ЭТОТ ФАЙЛ И КАК ВКЛЮЧАЕТСЯ
#   Отслеживаемая копия (эта):  scripts/hooks/pre-commit
#   Включить у себя:            git config core.hooksPath scripts/hooks
#   На машине владельца та же логика продублирована в глобальном
#   C:/Users/Admin/.git-hooks/pre-commit, который подключён через
#   core.hooksPath в C:/Users/Admin/.gitconfig и действует во всех
#   репозиториях этого пользователя.
#
#   ДО 2026-08-09 хук существовал ТОЛЬКО в глобальном каталоге вне репозитория.
#   Это значит, что ни у одного другого разработчика «железного гейта» не было
#   вовсе: .git/hooks и ~/.git-hooks не раздаются с клоном. Отслеживаемая копия
#   заведена именно поэтому.
#
# ЧТО БЫЛО ПОЧИНЕНО 2026-08-09
#   Прежняя версия печатала шапку «[1/2] … [2/2] …», выполняла ОДНУ проверку из
#   двух (Biome в PATH нет, ветка `command -v biome` уходила в else) и завершала
#   вывод строкой «All checks passed» — то есть заявляла успех проверки, которая
#   не выполнялась. Ниже это сделано структурно невозможным:
#     1) код возврата каждой проверки читается СРАЗУ в переменную и НИКОГДА
#        через конвейер: `cmd | tail; echo $?` вернул бы код `tail`, и в этом
#        проекте на таком ложном нуле обжигались дважды;
#     2) строка «All checks passed» печатается, только если ни одна проверка не
#        пропущена и ни одна не упала;
#     3) любой пропуск печатается как SKIPPED и НАЗВАН в итоговой строке;
#     4) любая красная проверка блокирует коммит (exit 1).
#
# ПОЧЕМУ ЗДЕСЬ НЕТ BIOME
#   Замер 2026-08-09: в package.json biome отсутствует и в dependencies, и в
#   devDependencies; в node_modules/.bin его нет; в PATH его нет. Глобально в
#   npm лежит @biomejs/biome@2.5.4 — именно он подхватывался, когда biome всё же
#   оказывался доступен, и работал он с ПРАВИЛАМИ ПО УМОЛЧАНИЮ. Такое «biome
#   чисто» ничего не доказывало о правилах проекта. Вместо фантома здесь стоят
#   четыре гейта, которые в проекте действительно есть и разбирают TypeScript
#   AST, а не текст.
# =============================================================================

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=""
if [ -n "$ROOT" ]; then
	cd "$ROOT" || exit 1
fi

echo "=========================================="
echo "    THE IRON GATE (Pre-Commit Check)      "
echo "=========================================="

PASSED=""
SKIPPED=""
FAILED=""

# -----------------------------------------------------------------------------
# [1/5] Секреты.
#
# Блокирует НЕМЕДЛЕННО, а не копит отказы: в этом репозитории был инцидент с
# утечкой токенов, и продолжать прогон после находки секрета незачем.
#
# Отсутствие самого gitleaks отделено от находки секретов. В прежней версии
# ненайденный бинарь давал код 127, попадал в ту же ветку и печатал «Gitleaks
# found potential secrets» — обвинение вместо диагноза.
# -----------------------------------------------------------------------------
echo "[1/5] gitleaks protect --staged (секреты в проиндексированном)..."
if command -v gitleaks >/dev/null 2>&1; then
	gitleaks protect -v --staged
	GITLEAKS_RC=$?
	if [ "$GITLEAKS_RC" -ne 0 ]; then
		echo "=========================================="
		echo "BLOCKED: gitleaks нашёл потенциальные секреты (код $GITLEAKS_RC)."
		echo "Коммит остановлен Iron Gate, чтобы секрет не попал в историю."
		echo "=========================================="
		exit 1
	fi
	PASSED="$PASSED gitleaks"
	echo "      gitleaks: OK"
else
	# Пропуск, а не молчание. Если политика ужесточится — здесь ставится exit 1.
	SKIPPED="$SKIPPED gitleaks(бинарь-не-найден-в-PATH)"
	echo "      SKIPPED: gitleaks не найден в PATH — СЕКРЕТЫ НЕ ПРОВЕРЕНЫ."
fi
echo ""

# -----------------------------------------------------------------------------
# [2/5]..[5/5] AST-гейты проекта.
#
# Замер длительности 2026-08-09 (npm run, холодный запуск, это дерево):
#   check:encoding        1.9 с
#   check:stub-overrides  1.5 с
#   check:fetch-response  1.7 с
#   check:dynamic-imports 0.7 с
#   итого                 ~5.7 с — укладывается в бюджет pre-commit.
#
# Тяжёлое сюда не ставится и остаётся в CI: npm run typecheck и наборы smoke:*
# идут минутами, а хук, который человек ждёт минуту, обходят через --no-verify,
# и тогда не работает уже ничего.
#
# ПОЧЕМУ КАЖДАЯ ПРОВЕРКА ПОД УСЛОВИЕМ. Хук глобальный и обслуживает не один
# репозиторий. Проверка запускается, только если репозиторий сам объявил её в
# package.json; не объявил — это ПРОПУСК, он назван в выводе и в итоговой
# строке, а не выдан за успех.
#
# ГРАНИЦА, названная честно: гейты разбирают ВСЁ дерево, а не только
# проиндексированное. Чужой красный файл остановит и ваш коммит.
# -----------------------------------------------------------------------------
declares_script() {
	[ -f package.json ] || return 1
	node -e "const s=require('./package.json').scripts||{};process.exit(s['$1']?0:1)" >/dev/null 2>&1
}

run_check() {
	check_label="$1"
	check_script="$2"
	echo "$check_label npm run $check_script ..."
	if ! declares_script "$check_script"; then
		SKIPPED="$SKIPPED $check_script(не-объявлен-в-package.json)"
		echo "      SKIPPED: $check_script в package.json этого репозитория нет."
		echo ""
		return 0
	fi
	npm run "$check_script"
	# Код возврата читается здесь, напрямую, без конвейера.
	check_rc=$?
	if [ "$check_rc" -ne 0 ]; then
		FAILED="$FAILED $check_script"
		echo "      FAILED: $check_script (код $check_rc)"
	else
		PASSED="$PASSED $check_script"
		echo "      $check_script: OK"
	fi
	echo ""
	return 0
}

run_check "[2/5]" check:encoding
run_check "[3/5]" check:stub-overrides
run_check "[4/5]" check:fetch-response
run_check "[5/5]" check:dynamic-imports

# -----------------------------------------------------------------------------
# Итог. Три РАЗНЫХ исхода и три разных текста: успех, успех-с-пропусками, отказ.
# «All checks passed» существует ровно в одной ветке — там, где это правда.
# -----------------------------------------------------------------------------
echo "=========================================="
if [ -n "$FAILED" ]; then
	echo "BLOCKED: Iron Gate остановил коммит."
	echo "  Упали:      $FAILED"
	if [ -n "$SKIPPED" ]; then
		echo "  Пропущены:  $SKIPPED"
	fi
	echo "  Прошли:     $PASSED"
	echo "Координаты дефектов напечатаны выше. Чините код, а не гейт."
	echo "=========================================="
	exit 1
fi

if [ -n "$SKIPPED" ]; then
	echo "PASSED WITH SKIPS — ВЫПОЛНЕНЫ НЕ ВСЕ ПРОВЕРКИ."
	echo "  Прошли:     $PASSED"
	echo "  ПРОПУЩЕНЫ:  $SKIPPED"
	echo "Это НЕ «все проверки пройдены»: перечисленное не выполнялось."
	echo "=========================================="
	exit 0
fi

echo "All checks passed:$PASSED"
echo "=========================================="
exit 0
