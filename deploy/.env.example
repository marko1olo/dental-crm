# ==============================================================================
# DENTE DENTAL CRM — 24/7 CLOUD VPS PRODUCTION ENVIRONMENT
# ==============================================================================
# Скопируйте этот файл в .env перед развертыванием:
#   cp .env.example .env
# Заполните DOMAIN, почту для SSL и сгенерируйте надежные секреты.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. СЕТЕВЫЕ НАСТРОЙКИ И ДОМЕН
# ------------------------------------------------------------------------------
# Основной домен вашей стоматологической клиники (без https:// и слэшей).
# Все поддомены (booking.*, my.*, lab.*, relay.*) настраиваются в DNS A-записью на IP вашего VPS.
DOMAIN=dente.pro

# Email администратора клиники для регистрации Let's Encrypt / ZeroSSL сертификатов.
# На этот адрес приходят важные уведомления о продлении TLS-сертификатов.
ACME_EMAIL=admin@dente.pro

# Разрешенные внешние сайты для встраивания онлайн-виджета через <iframe>.
# Укажите основной сайт клиники, лендинг, страницу на Tilda или WordPress.
# Разделяйте пробелами. Для разрешения всех: *
ALLOWED_IFRAME_ORIGINS="https://dente.pro https://www.dente.pro"

# ------------------------------------------------------------------------------
# 2. КРИПТОГРАФИЧЕСКИЕ СЕКРЕТЫ И БЕЗОПАСНОСТЬ
# ------------------------------------------------------------------------------
# Секретный ключ для туннеля клиники (WebSocket Relay).
# ЭТОТ ЖЕ КЛЮЧ должен быть прописан в локальной CRM в клинике (apps/api/.env -> RELAY_SECRET).
# Сгенерировать новый: openssl rand -hex 32
RELAY_SECRET=change_me_relay_secret_32_bytes_hex_key_required_for_prod

# Секрет для подписи JWT-токенов пациентов и зубных техников в облаке.
# Сгенерировать новый: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_32_bytes_hex_key_required_for_prod

# Пароль для доступа к Redis очереди (обязателен).
# Сгенерировать новый: openssl rand -hex 24
REDIS_PASSWORD=change_me_redis_secure_password_in_production

# ------------------------------------------------------------------------------
# 3. ДАННЫЕ КЛИНИКИ ДЛЯ ВИДЖЕТА И ЛИЧНОГО КАБИНЕТА
# ------------------------------------------------------------------------------
# Отображаются в заголовке онлайн-записи и в PWA пациента
CLINIC_NAME="Стоматологическая клиника ДЕНТЕ"
CLINIC_PHONE="+7 (495) 123-45-67"
CLINIC_ADDRESS="г. Москва, ул. Профсоюзная, д. 45"
CLINIC_WORK_HOURS="Пн-Вс: 09:00 — 21:00"
CLINIC_TIMEZONE="Europe/Moscow"
CLINIC_WEBSITE="https://dente.pro"

# ------------------------------------------------------------------------------
# 4. УВЕДОМЛЕНИЯ О НОВЫХ НОЧНЫХ ЗАПИСЯХ (ОПЦИОНАЛЬНО)
# ------------------------------------------------------------------------------
# Если ПК в клинике выключен ночью, облачный сервер может сразу отправить алерт
# администратору или дежурному врачу в Telegram.
# Создайте бота через @BotFather и узнайте ID чата через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Шлюз отправки SMS для подтверждения номера телефона пациента (SMS.RU / SMSC.RU / Zvonok)
# Если пусто — используется мгновенная запись без SMS или вывод проверочного кода в UI.
SMS_GATEWAY_API_KEY=

# ------------------------------------------------------------------------------
# 5. РЕЗЕРВНОЕ КОПИРОВАНИЕ S3 (ОПЦИОНАЛЬНО)
# ------------------------------------------------------------------------------
# Для автоматического создания бэкапов очередей и настроек в S3 (Selectel, MinIO, Yandex Cloud)
S3_ENDPOINT=https://s3.storage.selcloud.ru
S3_BUCKET=dente-vps-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1
