{$DOMAIN_NAME:bot.dente-clinic.ru} {
    # Automatic HTTPS via Let's Encrypt / ZeroSSL
    encode zstd gzip

    # Telegram Bot Webhook endpoint proxy
    handle /api/telegram/* {
        reverse_proxy telegram-bot-api:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # Health check probe
    handle /health {
        reverse_proxy telegram-bot-api:4000
    }

    # Static fallback
    handle {
        respond "DENTE Telegram Gateway Active" 200
    }
}
