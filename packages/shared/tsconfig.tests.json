{
	// Проверка типов ТЕСТОВ общего пакета.
	//
	// ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ СНЯТОЕ ИСКЛЮЧЕНИЕ В tsconfig.json. Тот у общего
	// пакета — конфигурация СБОРКИ: `npm run build` вызывает `tsc -p tsconfig.json`
	// и пишет в dist/ вместе с файлами объявлений. Включи тесты туда, и они уедут
	// в опубликованный вывод вместе с типами, а `declaration: true` начнёт
	// требовать объявлений и от них. Тот же довод, по которому отдельный конфиг
	// сделан у apps/api.
	//
	// ЧТО ЭТО ЗАКРЫВАЕТ. В tsconfig.json стоит
	// `exclude: ["src/tests", "src/**/*.test.ts"]`, и потому `tsc --noEmit` —
	// гейт, на который в проекте ссылаются как на «типы чисто», — не брал в
	// программу НИ ОДНОГО тестового файла общего пакета. Замер 2026-07-29:
	// тестовых файлов 7, под гейтом 0.
	//
	// Это та же дыра, которую в тот же день закрыли в apps/api, и там она стоила
	// 155 ошибок в 30 файлах. Здесь цена измерена ДО правки и оказалась нулевой:
	// включение тестов не дало ни одной ошибки. Тем меньше причин держать её
	// открытой — дыра без цены закрытия это просто забытая настройка.
	//
	// ПОЧЕМУ ЭТО ВАЖНО ИМЕННО В ОБЩЕМ ПАКЕТЕ. Здесь живут денежные контракты и
	// разбор дат: `money-contract-kopecks.test.ts` охраняет копейки в 45 денежных
	// полях, `dates.test.ts` — календарные границы. Ошибка типа в таком тесте
	// означает, что охрана денег и дат проверяет не то, что думает.
	//
	// ЗАПУСК: cd packages/shared && npm run typecheck:tests
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Ничего не пишем: это проверка, а не сборка. Без этого tsc потребовал бы
		// outDir и начал бы складывать тесты рядом с опубликованными типами.
		"noEmit": true,
		"declaration": false,
		// rootDir не имеет смысла без записи и мешает включению src/tests.
		"rootDir": "."
	},
	"include": ["src"],
	// Пусто намеренно: в этом конфиге проверяется ВСЁ, включая тесты. Появится
	// здесь исключение — вернётся ровно та дыра, ради которой файл и заведён.
	"exclude": []
}
