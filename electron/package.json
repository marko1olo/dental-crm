{
  "name": "@dental/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DENTE Dental CRM — Desktop Windows Standalone Runtime (.EXE)",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/package-desktop.mjs",
    "pack": "electron-builder --config electron-builder.json --dir",
    "dist": "electron-builder --config electron-builder.json --win",
    "check": "node --check main.cjs && node --check preload.cjs",
    "test": "node --test test/*.test.mjs __tests__/*.test.mjs"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.6.2"
  },
  "keywords": [
    "dental",
    "crm",
    "electron",
    "windows",
    "desktop",
    "twain",
    "dicom",
    "kkt"
  ],
  "author": "DENTE Dental CRM",
  "license": "MIT"
}
